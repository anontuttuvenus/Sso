import json

r = json.load(open("amcash-v2-results/results.json"))

for x in r:
    if x["label"].startswith("race:"):
        j = x.get("response") or {}

        print("\n========", x["label"], "========")
        for k in [
            "responseCode",
            "message",
            "pointsBalance",
            "availablePointsBalance",
            "availableDollarAmount",
            "pointsRedeemed",
            "milesRedeemed",
            "unitsRedeemed",
            "txnConfirmationNumber",
            "idempotencyId"
        ]:
            if k in j:
                print(k, ":", j[k])
