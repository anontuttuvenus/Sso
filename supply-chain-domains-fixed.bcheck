metadata:
  language: v2-beta
  name: "Passive Supply Chain Domain and CDN Hygiene Check"
  description: "Passively detects known compromised JavaScript/CDN supply-chain indicators and common third-party resource hygiene issues in HTML, JavaScript, JSON, and response headers."
  author: "s3c4n0n, reviewed by GPT-5.5 Pro"
  tags: "supply-chain", "passive", "a08-2021", "cwe-829", "sri", "javascript"

given response then

  #############################################################
  # Cluster 1: Funnull / Polyfill.io supply-chain indicators
  # Scans the whole response, not just the body, so CSP headers
  # and other response headers are also checked passively.
  #############################################################

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:[a-z0-9-]+\.)*polyfill\.io([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to polyfill.io / cdn.polyfill.io"
      severity: high
      confidence: certain
      detail: `The response references polyfill.io or a subdomain such as cdn.polyfill.io. The Polyfill service was taken over and used to serve malicious JavaScript to sites that embedded it. This BCheck matched passively in the response or headers for: {latest.request.url}`
      remediation: "Remove all polyfill.io references. Prefer removing Polyfill entirely for modern browsers, self-hosting required polyfills, or using a trusted maintained mirror with version pinning and SRI."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:[a-z0-9-]+\.)*polyfill\.com([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to polyfill.com"
      severity: high
      confidence: firm
      detail: `The response references polyfill.com or a subdomain. This domain was reported as a newer domain associated with the Polyfill/Funnull supply-chain activity. Matched while checking: {latest.request.url}`
      remediation: "Remove all polyfill.com references and investigate how the reference entered the application or dependency bundle."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:[a-z0-9-]+\.)*polyfill\.site([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to polyfill.site"
      severity: high
      confidence: firm
      detail: `The response references polyfill.site or a subdomain. This domain was reported as part of the broader Polyfill/Funnull indicator set. Matched while checking: {latest.request.url}`
      remediation: "Remove all polyfill.site references and investigate the source of the reference."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:cdn\.|wildcard\.)?polyfill\.io\.bsclink\.cn([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to polyfill.io.bsclink.cn"
      severity: high
      confidence: firm
      detail: `The response references a polyfill.io.bsclink.cn hostname. This hostname family appeared in historical DNS investigation around cdn.polyfill.io. Matched while checking: {latest.request.url}`
      remediation: "Remove this reference immediately and investigate for compromise or stale malicious supply-chain indicators."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])5f52353c\.u\.fn03\.vip([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to 5f52353c.u.fn03.vip"
      severity: high
      confidence: firm
      detail: `The response references 5f52353c.u.fn03.vip, a hostname observed in historical DNS research around cdn.polyfill.io. Matched while checking: {latest.request.url}`
      remediation: "Remove this reference immediately and investigate for compromise or stale malicious supply-chain indicators."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:[a-z0-9-]+\.)*bootcdn\.net([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to bootcdn.net"
      severity: high
      confidence: firm
      detail: `The response references bootcdn.net or a subdomain. This domain was reported in the Funnull/Polyfill supply-chain indicator cluster. Matched while checking: {latest.request.url}`
      remediation: "Remove bootcdn.net references. Replace with self-hosted assets or a trusted CDN with exact version pinning and SRI."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:[a-z0-9-]+\.)*bootcss\.com([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to bootcss.com"
      severity: high
      confidence: firm
      detail: `The response references bootcss.com or a subdomain such as cdn.bootcss.com. bootcss.com was reported as associated with similar malicious activity before the public Polyfill disclosure. Matched while checking: {latest.request.url}`
      remediation: "Remove bootcss.com references. Replace with self-hosted assets or a trusted CDN with exact version pinning and SRI."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:[a-z0-9-]+\.)*staticfile\.net([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to staticfile.net"
      severity: high
      confidence: firm
      detail: `The response references staticfile.net or a subdomain. This domain was reported in the Funnull/Polyfill supply-chain indicator cluster. Matched while checking: {latest.request.url}`
      remediation: "Remove staticfile.net references and replace with controlled, pinned, integrity-protected assets."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:[a-z0-9-]+\.)*staticfile\.org([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to staticfile.org"
      severity: high
      confidence: firm
      detail: `The response references staticfile.org or a subdomain. This domain was reported in the Funnull/Polyfill supply-chain indicator cluster. Matched while checking: {latest.request.url}`
      remediation: "Remove staticfile.org references and replace with controlled, pinned, integrity-protected assets."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:[a-z0-9-]+\.)*unionadjs\.com([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to unionadjs.com"
      severity: high
      confidence: certain
      detail: `The response references unionadjs.com or a subdomain, a reported malware/ad-injection domain in the Polyfill/Funnull cluster. Matched while checking: {latest.request.url}`
      remediation: "Remove the reference immediately and investigate the page, templates, tag manager, and bundled JavaScript for compromise."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:[a-z0-9-]+\.)*xhsbpza\.com([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to xhsbpza.com"
      severity: high
      confidence: certain
      detail: `The response references xhsbpza.com or a subdomain, a reported malicious payload/redirect domain in the Polyfill/Funnull cluster. Matched while checking: {latest.request.url}`
      remediation: "Remove the reference immediately and investigate for active compromise."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:[a-z0-9-]+\.)*union\.macoms\.la([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to union.macoms.la"
      severity: high
      confidence: certain
      detail: `The response references union.macoms.la or a related subdomain, a reported malicious payload source in the Polyfill/Funnull cluster. Matched while checking: {latest.request.url}`
      remediation: "Remove the reference immediately and investigate the page, templates, tag manager, and bundled JavaScript for compromise."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:[a-z0-9-]+\.)*newcrbpc\.com([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to newcrbpc.com"
      severity: high
      confidence: certain
      detail: `The response references newcrbpc.com or a subdomain, a reported malicious redirect/payload domain in the Polyfill/Funnull cluster. Matched while checking: {latest.request.url}`
      remediation: "Remove the reference immediately and investigate for active compromise."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:[a-z0-9-]+\.)*googie-anaiytics\.com([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to googie-anaiytics.com"
      severity: high
      confidence: certain
      detail: `The response references googie-anaiytics.com or a subdomain. This typo-squatted analytics-looking domain was reported as a malicious Polyfill payload indicator. Matched while checking: {latest.request.url}`
      remediation: "Remove the reference immediately. Treat this as a compromise indicator and review tag managers, templates, and bundled JavaScript."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:[a-z0-9-]+\.)*kuurza\.com([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to kuurza.com"
      severity: high
      confidence: certain
      detail: `The response references kuurza.com or a subdomain, a reported redirect indicator in the Polyfill/Funnull incident set. Matched while checking: {latest.request.url}`
      remediation: "Remove the reference immediately and investigate for active compromise."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:[a-z0-9-]+\.)*vty70\.net([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to vty70.net"
      severity: high
      confidence: firm
      detail: `The response references vty70.net or a subdomain, a reported redirect destination in analysis of the Polyfill malware behavior. Matched while checking: {latest.request.url}`
      remediation: "Remove the reference immediately and investigate for active compromise or malicious redirection."
  end if

  #############################################################
  # Cluster 2: Trojanized jQuery / suspicious package-channel IOCs
  #############################################################

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:[a-z0-9-]+\.)*jquery\.js\.cn([^a-z0-9.-]|$)" then
    report issue and continue:
      name: "[Supply Chain] Reference to jquery.js.cn"
      severity: high
      confidence: firm
      detail: `The response references jquery.js.cn or a subdomain. This domain has been reported in relation to trojanized jQuery distribution. Matched while checking: {latest.request.url}`
      remediation: "Remove the reference. Load jQuery only from a trusted source, pin the exact version, and use SRI; self-hosting reviewed code is preferred."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])cdn\.jsdelivr\.net/gh/indexsc/" then
    report issue and continue:
      name: "[Supply Chain] Reference to jsDelivr GitHub indexsc content"
      severity: high
      confidence: firm
      detail: `The response references cdn.jsdelivr.net/gh/indexsc/. The indexsc GitHub account was reported in analysis of trojanized jQuery content served through jsDelivr. Matched while checking: {latest.request.url}`
      remediation: "Remove this reference. Replace with a trusted upstream package, exact version pinning, and SRI, or self-host reviewed code."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])github\.com/indexsc/" then
    report issue and continue:
      name: "[Supply Chain] Reference to GitHub indexsc content"
      severity: high
      confidence: firm
      detail: `The response references github.com/indexsc/. The indexsc GitHub account was reported in analysis of trojanized jQuery content. Matched while checking: {latest.request.url}`
      remediation: "Remove this reference. Replace with a trusted upstream package, exact version pinning, and SRI, or self-host reviewed code."
  end if

  if {to_lower(latest.response)} matches "(^|[^a-z0-9.-])(?:cdn\.jsdelivr\.net/npm|unpkg\.com)/(?:cdnjquery|footersicons|jquertyi|jqueryxxx|logoo|sytlesheets)(?:@|/|[\"'?&#\s])" then
    report issue and continue:
      name: "[Supply Chain] Reference to reported suspicious npm package name"
      severity: high
      confidence: firm
      detail: `The response references a package name reported in the trojanized jQuery campaign via a public CDN. Matched while checking: {latest.request.url}`
      remediation: "Remove the package reference, audit the dependency tree, and replace it with the legitimate upstream library from a trusted source."
  end if

  #############################################################
  # Cluster 3: HTML supply-chain hygiene checks
  # These run only on responses that look like HTML.
  #############################################################

  if ({to_lower(latest.response.headers)} matches "content-type:\s*text/html" or {to_lower(latest.response.body)} matches "<!doctype html|<html") and {to_lower(latest.response.body)} matches "<script\b(?=[^>]*\bsrc\s*=\s*['\"](?:https?:)?//)(?![^>]*\bintegrity\s*=)[^>]*>" then
    report issue and continue:
      name: "[Supply Chain] External script loaded without SRI"
      severity: info
      confidence: tentative
      detail: `The HTML response appears to load an external script without an integrity attribute. If the third-party host or CDN is compromised, users may execute modified JavaScript. Matched while checking: {latest.request.url}`
      remediation: "Add integrity and crossorigin attributes to external script tags, pin exact versions, or self-host reviewed assets."
  end if

  if ({to_lower(latest.response.headers)} matches "content-type:\s*text/html" or {to_lower(latest.response.body)} matches "<!doctype html|<html") and {to_lower(latest.response.body)} matches "<link\b(?=[^>]*\bhref\s*=\s*['\"](?:https?:)?//)(?=[^>]*\brel\s*=\s*['\"][^'\"]*(stylesheet|preload|modulepreload)[^'\"]*['\"])(?![^>]*\bintegrity\s*=)[^>]*>" then
    report issue and continue:
      name: "[Supply Chain] External stylesheet/preload loaded without SRI"
      severity: info
      confidence: tentative
      detail: `The HTML response appears to load an external stylesheet, preload, or modulepreload resource without an integrity attribute. Matched while checking: {latest.request.url}`
      remediation: "Add integrity and crossorigin attributes where supported, pin exact versions, or self-host reviewed assets."
  end if

  if ({to_lower(latest.response.headers)} matches "content-type:\s*text/html" or {to_lower(latest.response.body)} matches "<!doctype html|<html") and {to_lower(latest.response.body)} matches "<script\b(?=[^>]*\bsrc\s*=\s*['\"]http://)[^>]*>" then
    report issue and continue:
      name: "[Supply Chain] External script loaded over HTTP"
      severity: medium
      confidence: firm
      detail: `The HTML response appears to load an external script over plain HTTP. This exposes the script to network modification and can become a client-side supply-chain compromise. Matched while checking: {latest.request.url}`
      remediation: "Load third-party scripts only over HTTPS, and add SRI plus exact version pinning where possible."
  end if

  if ({to_lower(latest.response.headers)} matches "content-type:\s*text/html" or {to_lower(latest.response.body)} matches "<!doctype html|<html") and {to_lower(latest.response.body)} matches "<link\b(?=[^>]*\bhref\s*=\s*['\"]http://)(?=[^>]*\brel\s*=\s*['\"][^'\"]*(stylesheet|preload|modulepreload)[^'\"]*['\"])[^>]*>" then
    report issue and continue:
      name: "[Supply Chain] External stylesheet/preload loaded over HTTP"
      severity: medium
      confidence: firm
      detail: `The HTML response appears to load an external stylesheet, preload, or modulepreload resource over plain HTTP. This exposes the resource to network modification. Matched while checking: {latest.request.url}`
      remediation: "Load third-party resources only over HTTPS, and add SRI plus exact version pinning where possible."
  end if

  #############################################################
  # Cluster 4: Version pinning checks for public package CDNs
  #############################################################

  if {to_lower(latest.response)} matches "cdn\.jsdelivr\.net/npm/[^\"'\s<>]*@latest(?:[/?#\"'\s<>]|$)" then
    report issue and continue:
      name: "[Supply Chain] jsDelivr dependency uses @latest"
      severity: info
      confidence: firm
      detail: `The response references a jsDelivr npm URL using @latest. This makes the browser load whatever version is current at request time, which weakens reviewability and SRI usage. Matched while checking: {latest.request.url}`
      remediation: "Pin an exact package version and add SRI. Avoid @latest, broad ranges, and mutable CDN aliases for production assets."
  end if

  if {to_lower(latest.response)} matches "unpkg\.com/[^\"'\s<>]*@latest(?:[/?#\"'\s<>]|$)" then
    report issue and continue:
      name: "[Supply Chain] unpkg dependency uses @latest"
      severity: info
      confidence: firm
      detail: `The response references an unpkg URL using @latest. This makes the browser load whatever version is current at request time, which weakens reviewability and SRI usage. Matched while checking: {latest.request.url}`
      remediation: "Pin an exact package version and add SRI. Avoid @latest, broad ranges, and mutable CDN aliases for production assets."
  end if

  if {to_lower(latest.response)} matches "esm\.sh/[^\"'\s<>]*@latest(?:[/?#\"'\s<>]|$)" then
    report issue and continue:
      name: "[Supply Chain] esm.sh dependency uses @latest"
      severity: info
      confidence: firm
      detail: `The response references an esm.sh URL using @latest. This makes the browser load whatever version is current at request time. Matched while checking: {latest.request.url}`
      remediation: "Pin an exact package version and add SRI or import maps where appropriate. Avoid @latest in production assets."
  end if

  if {to_lower(latest.response)} matches "skypack\.dev/[^\"'\s<>]*@latest(?:[/?#\"'\s<>]|$)" then
    report issue and continue:
      name: "[Supply Chain] Skypack dependency uses @latest"
      severity: info
      confidence: firm
      detail: `The response references a Skypack URL using @latest. This makes the browser load whatever version is current at request time. Matched while checking: {latest.request.url}`
      remediation: "Pin an exact package version and add integrity controls where possible. Avoid @latest in production assets."
  end if

  if {to_lower(latest.response)} matches "cdn\.jsdelivr\.net/npm/(?:@[^/\"'\s<>]+/[^@/\"'\s<>]+|[^@/\"'\s<>]+)(?:/|[?#\"'\s<>]|$)" then
    report issue and continue:
      name: "[Supply Chain] jsDelivr dependency appears versionless"
      severity: info
      confidence: tentative
      detail: `The response appears to reference a jsDelivr npm package URL without an exact version in the package segment. Versionless CDN imports are mutable and make review, rollback, and SRI harder. Matched while checking: {latest.request.url}`
      remediation: "Pin an exact package version and add SRI. Avoid versionless public CDN imports for production assets."
  end if

  if {to_lower(latest.response)} matches "unpkg\.com/(?:@[^/\"'\s<>]+/[^@/\"'\s<>]+|[^@/\"'\s<>]+)(?:/|[?#\"'\s<>]|$)" then
    report issue and continue:
      name: "[Supply Chain] unpkg dependency appears versionless"
      severity: info
      confidence: tentative
      detail: `The response appears to reference an unpkg package URL without an exact version in the package segment. Versionless CDN imports are mutable and make review, rollback, and SRI harder. Matched while checking: {latest.request.url}`
      remediation: "Pin an exact package version and add SRI. Avoid versionless public CDN imports for production assets."
  end if

  if {to_lower(latest.response)} matches "esm\.sh/(?:@[^/\"'\s<>]+/[^@/\"'\s<>]+|[^@/\"'\s<>]+)(?:/|[?#\"'\s<>]|$)" then
    report issue and continue:
      name: "[Supply Chain] esm.sh dependency appears versionless"
      severity: info
      confidence: tentative
      detail: `The response appears to reference an esm.sh package URL without an exact version in the package segment. Versionless CDN imports are mutable and make review and rollback harder. Matched while checking: {latest.request.url}`
      remediation: "Pin an exact package version. Avoid versionless public CDN imports for production assets."
  end if

  if {to_lower(latest.response)} matches "skypack\.dev/(?:@[^/\"'\s<>]+/[^@/\"'\s<>]+|[^@/\"'\s<>]+)(?:/|[?#\"'\s<>]|$)" then
    report issue and continue:
      name: "[Supply Chain] Skypack dependency appears versionless"
      severity: info
      confidence: tentative
      detail: `The response appears to reference a Skypack package URL without an exact version in the package segment. Versionless CDN imports are mutable and make review and rollback harder. Matched while checking: {latest.request.url}`
      remediation: "Pin an exact package version. Avoid versionless public CDN imports for production assets."
  end if

